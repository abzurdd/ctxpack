{
  "name": "@abzurdd/ctxpack",
  "version": "1.1.0",
  "description": "Fast, zero-dependency CLI & library to bundle codebases into token-counted, secret-safe prompts for Claude, Gemini, and GPT",
  "main": "./lib/index.js",
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ctxpack": "./bin/ctxpack.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node --check bin/ctxpack.js lib/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abzurdd/ctxpack.git"
  },
  "keywords": [
    "claude",
    "gemini",
    "gpt",
    "llm",
    "context",
    "cli",
    "codebase",
    "prompt-engineering",
    "token-counter",
    "developer-tools",
    "open-source"
  ],
  "author": "Abhishek Chattopadhyay <iabhishek113@gmail.com> (https://github.com/abzurdd)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abzurdd/ctxpack/issues"
  },
  "homepage": "https://github.com/abzurdd/ctxpack#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
